ZMK_MACRO(del_line,
    bindings
        = <&macro_press &kp END>
        , <&macro_press &kp LSHFT>
        , <&macro_tap &kp HOME>
        , <&macro_release &kp LSHFT>
        , <&macro_tap &kp BSPC>
        ;
)

ZMK_MACRO(dot_spc,
    wait-ms = <0>;
    tap-ms = <5>;
    bindings = <&kp DOT &kp SPACE &sk LSHFT>;
)

ZMK_MACRO(macro_qu,
    bindings = <&kp Q &kp U>;
)

ZMK_MACRO(macro_chat,
    bindings = <&to BASE_WIN &kp SLASH>;
)


// Sticky shift + leader
ZMK_MACRO(leader_sft, bindings = <&sk LSHFT &leader>;)