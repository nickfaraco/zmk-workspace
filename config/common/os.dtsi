/* OS handling
 *
 * BASE is the macOS base layer; BASE_WIN is a transparent overlay with the
 * Linux/Windows differences. Which one is active is stored per endpoint (USB
 * and each BT profile) by the default-layer module and survives reboots.
 *
 * Unicode input follows the layer through a layer listener: entering BASE_WIN
 * selects Linux input, leaving it selects macOS input. Windows (WinCompose) is
 * an explicit, non-persistent override via &to_pc.
 */

#include <behaviors/default_layer.dtsi> // requires zmk-feature-default-layer module
#include <dt-bindings/zmk_behavior_default_layer/default_layer.h>

&uc {
    default-mode = <UC_MODE_MACOS>;
};

/ {
    layer_listeners {
        compatible = "zmk,layer-listeners"; // requires zmk-listeners module

        os_unicode {
            layers = <BASE_WIN>;
            bindings = <&uc UC_SET_LINUX>, <&uc UC_SET_MACOS>;
        };
    };
};

// Select the OS for the current endpoint. The explicit unicode mode is set on
// release, so that it runs after the layer listener triggered on press.
ZMK_MACRO(to_osx,
    bindings
        = <&df DF_SEL BASE>
        , <&macro_pause_for_release>
        , <&uc UC_SET_MACOS>
        ;
)
ZMK_MACRO(to_linux,
    bindings
        = <&df DF_SEL BASE_WIN>
        , <&macro_pause_for_release>
        , <&uc UC_SET_LINUX>
        ;
)
ZMK_MACRO(to_pc,
    bindings
        = <&df DF_SEL BASE_WIN>
        , <&macro_pause_for_release>
        , <&uc UC_SET_WIN_COMPOSE>
        ;
)

#if WIRELESS
// Dedicated BT profiles: 0 = Mac, 1 = PC. Selecting a profile restores its
// stored layer; setting it again here keeps the mapping in place.
ZMK_MACRO(osx_connect,
    wait-ms = <100>;
    tap-ms = <5>;
    bindings = <&bt BT_SEL 0 &df DF_SEL BASE>;
)
ZMK_MACRO(pc_connect,
    wait-ms = <100>;
    tap-ms = <5>;
    bindings = <&bt BT_SEL 1 &df DF_SEL BASE_WIN>;
)
#endif
